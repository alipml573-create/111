{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "allowSyntheticDefaultImports": true,
    "noEmit": true,
    "paths": { "@/*": ["./support/*"] }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "support/**/*.ts",
    "support/**/*.tsx",
    "vendor/react-bits/src/**/*.tsx",
    "vendor/magicui/apps/www/registry/**/*.tsx"
  ]
}
